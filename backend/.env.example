# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=ChessMotion
APP_ENV=development

# ── Paths ───────────────────────────────────────────────────────────────────────
TEMP_DIR=./temp
OUTPUT_DIR=./output
ASSETS_DIR=./assets

# ── CORS (comma-separated, or * to allow all origins) ───────────────────────────
# Dev:        ALLOWED_ORIGINS=http://localhost:3000
# Production: ALLOWED_ORIGINS=https://chessmotion.vercel.app,https://your-domain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Stockfish (set absolute path to binary if installed) ─────────────────────────
STOCKFISH_PATH=

# ── Lichess (public API – token only needed for private games) ───────────────────
LICHESS_TOKEN=
