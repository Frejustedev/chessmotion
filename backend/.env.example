# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=ChessMotion
APP_ENV=development
SECRET_KEY=change_me_in_production

# ── Paths ───────────────────────────────────────────────────────────────────────
TEMP_DIR=./temp
OUTPUT_DIR=./output
ASSETS_DIR=./assets

# ── CORS ────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Stockfish (set absolute path to binary if installed) ─────────────────────────
STOCKFISH_PATH=

# ── Lichess (public API, token only needed for private games) ────────────────────
LICHESS_TOKEN=
